{
  "name": "@eventou/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/cli.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "user:set-role": "tsx --env-file-if-exists=.env src/modules/auth/setRole.cli.ts",
    "notifications:retry": "tsx --env-file-if-exists=.env src/modules/subscriptions/retryNotifications.cli.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "express": "^5.3.0",
    "nodemailer": "^10.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
