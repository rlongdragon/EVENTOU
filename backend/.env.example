PORT=3000
DATABASE_PATH=data/eventou.db
INGESTION_INTERVAL_MS=3600000
INGESTION_REQUEST_INTERVAL_MS=1000
INGESTION_TIMEOUT_MS=30000
INGESTION_RETRIES=2

# 海大 CAS 登入（#90）
# CAS 只發票給 *.ntou.edu.tw 的 service，回呼網址為 PUBLIC_BASE_URL + /api/auth/cas/callback
CAS_BASE_URL=https://tccas.ntou.edu.tw/cas
# 新帳號的預設通知信箱為「學號@此網域」；留空則不預設
SCHOOL_EMAIL_DOMAIN=mail.ntou.edu.tw
# 模擬登入（不經 CAS，任意學號登入）：npm run dev 會從 .env.development 開啟；NODE_ENV=production 時一律停用
AUTH_DEV_LOGIN=

# 新活動 Email 通知（US-08）
# 網站對外位址：CAS 回呼網址、信中的活動連結與取消訂閱連結都以此為準（正式環境為 https://eventou.ind.ntou.edu.tw）
PUBLIC_BASE_URL=http://localhost:5173
# 通知排程的間隔毫秒數（預設 5 分鐘）
NOTIFICATION_INTERVAL_MS=300000
# SMTP 設定；SMTP_HOST 留空時不會真的寄信，只把信件內容印在主控台
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EVENTOU <no-reply@example.com>

# 跨來源重複活動偵測（US-20）：分數 0–1，達高門檻自動合併、達低門檻標記可能重複
DEDUP_HIGH_THRESHOLD=0.75
DEDUP_LOW_THRESHOLD=0.5

# #69 用 LLM 整理公告（OpenAI 相容的 chat completions）。沒設定 LLM_BASE_URL 或 LLM_MODEL 時只用規則擷取。
# 金鑰不可提交；結果以公告內容雜湊快取在 llm_extractions，內容沒變不會重複呼叫。
# 回填已擷取的公告：npm run events:reprocess -w backend
LLM_BASE_URL=https://ai.rlong.me/v1
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=
LLM_TIMEOUT_MS=60000
