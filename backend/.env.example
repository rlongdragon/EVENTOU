PORT=3000
DATABASE_PATH=data/eventou.db
INGESTION_INTERVAL_MS=3600000
INGESTION_REQUEST_INTERVAL_MS=1000
INGESTION_TIMEOUT_MS=30000
INGESTION_RETRIES=2

# 新活動 Email 通知（US-08）
# 信中的活動連結與取消訂閱連結以這個位址為準
PUBLIC_BASE_URL=http://localhost:5173
# 通知排程的間隔毫秒數（預設 5 分鐘）
NOTIFICATION_INTERVAL_MS=300000
# SMTP 設定；SMTP_HOST 留空時不會真的寄信，只把信件內容印在主控台
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EVENTOU <no-reply@example.com>
